enum CarCompanyRole {
  OWNER
  MANAGER
  FLEET
  RESERVATIONS
  FINANCE
  VIEWER
}

enum CarCompanyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum CarCompanyReviewStatus {
  PENDING
  APPROVED
  REJECTED
  STALE
}

enum CarVehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum CarTransmission {
  AUTOMATIC
  MANUAL
}

enum CarFuel {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum CarReservationStatus {
  HOLD
  CONFIRMED
  MODIFIED
  CANCELLED
  NO_SHOW
  COMPLETED
  EXPIRED
}

enum CarPaymentMode {
  PAY_NOW
  PAY_AT_COUNTER
}

model CarRentalCompany {
  id                String                 @id @default(cuid())
  name              String
  slug              String                 @unique
  city              String
  countryCode       String                 @db.Char(2)
  address           String
  timezone          String                 @default("Asia/Amman")
  currency          String                 @default("JOD") @db.Char(3)
  status            CarCompanyStatus       @default(DRAFT)
  verified          Boolean                @default(false)
  publishRevision   Int                    @default(1)
  publishedRevision Int?
  lastPublishedAt   DateTime?
  supportEmail      String?
  supportPhone      String?
  commissionRate    Decimal                @default(0.10) @db.Decimal(6, 5)
  memberships       CarCompanyMembership[]
  locations         CarRentalLocation[]
  vehicles          CarVehicle[]
  ratePlans         CarRatePlan[]
  reservations      CarReservation[]
  reviews           CarCompanyReview[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([status, verified, city])
  @@index([countryCode, city])
}

model CarCompanyReview {
  id                String                 @id @default(cuid())
  companyId         String
  company           CarRentalCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedByUserId String
  reviewedByUserId  String?
  submittedRevision Int
  status            CarCompanyReviewStatus @default(PENDING)
  readinessSnapshot Json
  decisionReason    String?                @db.Text
  submittedAt       DateTime               @default(now())
  reviewedAt        DateTime?

  @@index([companyId, submittedAt])
  @@index([status, submittedAt])
  @@index([reviewedByUserId, reviewedAt])
}

model CarCompanyMembership {
  id        String           @id @default(cuid())
  companyId String
  company   CarRentalCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  role      CarCompanyRole   @default(OWNER)
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, userId])
  @@index([userId, status])
}

model CarRentalLocation {
  id             String           @id @default(cuid())
  companyId      String
  company        CarRentalCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  city           String
  address        String
  airportCode    String?          @db.VarChar(3)
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  pickupEnabled  Boolean          @default(true)
  returnEnabled  Boolean          @default(true)
  active         Boolean          @default(true)
  homeVehicles   CarVehicle[]
  pickupBookings CarReservation[] @relation("CarPickupLocation")
  returnBookings CarReservation[] @relation("CarReturnLocation")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([companyId, active, city])
  @@index([airportCode])
}

model CarVehicle {
  id                 String               @id @default(cuid())
  companyId          String
  company            CarRentalCompany     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  homeLocationId     String?
  homeLocation       CarRentalLocation?   @relation(fields: [homeLocationId], references: [id], onDelete: SetNull)
  make               String
  model              String
  year               Int
  category           String
  transmission       CarTransmission
  fuel               CarFuel
  seats              Int
  bags               Int                  @default(2)
  doors              Int                  @default(4)
  airConditioning    Boolean              @default(true)
  dailyPrice         Decimal              @db.Decimal(10, 2)
  deposit            Decimal              @default(0) @db.Decimal(10, 2)
  freeCancellation   Boolean              @default(true)
  unlimitedMileage   Boolean              @default(false)
  airportPickup      Boolean              @default(false)
  imageUrl           String?
  imageAlt           String?
  status             CarVehicleStatus     @default(ACTIVE)
  ratePlans          CarRatePlan[]
  availability       CarAvailabilityDay[]
  reservations       CarReservation[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([companyId, status, category])
  @@index([make, model])
  @@index([homeLocationId, status])
}

model CarRatePlan {
  id                String           @id @default(cuid())
  companyId         String
  company           CarRentalCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicleId         String?
  vehicle           CarVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name              String
  dailyPrice        Decimal          @db.Decimal(10, 2)
  deposit           Decimal          @default(0) @db.Decimal(10, 2)
  freeCancellation  Boolean          @default(true)
  cancellationHours Int              @default(24)
  unlimitedMileage  Boolean          @default(false)
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([companyId, active])
  @@index([vehicleId, active])
}

model CarAvailabilityDay {
  id         String     @id @default(cuid())
  vehicleId  String
  vehicle    CarVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date       DateTime   @db.Date
  available  Boolean    @default(true)
  dailyPrice Decimal?   @db.Decimal(10, 2)
  minDays    Int        @default(1)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([vehicleId, date])
  @@index([date, available])
}

model CarReservation {
  id               String               @id @default(cuid())
  reference        String               @unique
  companyId        String
  company          CarRentalCompany     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicleId        String
  vehicle          CarVehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  pickupLocationId String
  pickupLocation   CarRentalLocation    @relation("CarPickupLocation", fields: [pickupLocationId], references: [id], onDelete: Restrict)
  returnLocationId String
  returnLocation   CarRentalLocation    @relation("CarReturnLocation", fields: [returnLocationId], references: [id], onDelete: Restrict)
  userId           String?
  guestName        String
  guestEmail       String
  guestPhone       String?
  driverAgeRange   String
  pickupAt         DateTime
  returnAt         DateTime
  status           CarReservationStatus @default(HOLD)
  paymentMode      CarPaymentMode       @default(PAY_AT_COUNTER)
  currency         String               @db.Char(3)
  dailyRate        Decimal              @db.Decimal(10, 2)
  rentalDays       Int
  subtotal         Decimal              @db.Decimal(10, 2)
  fees             Decimal              @default(0) @db.Decimal(10, 2)
  total            Decimal              @db.Decimal(10, 2)
  deposit          Decimal              @default(0) @db.Decimal(10, 2)
  cancellationNote String?              @db.Text
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([companyId, status, pickupAt])
  @@index([vehicleId, pickupAt, returnAt])
  @@index([userId, createdAt])
  @@index([guestEmail, createdAt])
}

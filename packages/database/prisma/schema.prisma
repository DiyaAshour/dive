generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  GUEST
  HOTEL_USER
  PLATFORM_ADMIN
}

enum SessionScope {
  STANDARD
  ADMIN
}

enum HotelRole {
  OWNER
  MANAGER
  REVENUE
  FRONT_DESK
  FINANCE
  VIEWER
}

enum RoomUnitType {
  ROOM
  STUDIO
  SUITE
  APARTMENT
  VILLA
  CHALET
  BUNGALOW
  HOLIDAY_HOME
  DORMITORY_ROOM
  BED_IN_DORMITORY
}

enum RoomSizeUnit {
  SQM
  SQFT
}

enum RoomSmokingPolicy {
  NON_SMOKING
  SMOKING
  BOTH
}

enum BedType {
  SINGLE
  DOUBLE
  QUEEN
  KING
  EXTRA_LARGE_DOUBLE
  SOFA_BED
  BUNK_BED
  FUTON
  MURPHY_BED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum PropertyReviewStatus {
  PENDING
  APPROVED
  REJECTED
  STALE
}

enum MediaKind {
  HOTEL_IMAGE
  VERIFICATION_DOCUMENT
}

enum MediaState {
  PENDING_UPLOAD
  READY
  DELETED
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum HotelDocumentType {
  COMMERCIAL_REGISTRATION
  BUSINESS_LICENSE
  TAX_REGISTRATION
  BANK_PROOF
  OWNER_ID
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  MODIFIED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum ArrivalStatus {
  NOT_PROVIDED
  EXPECTED
  ARRIVED
}

enum GuestRequestCategory {
  ARRIVAL
  BEDDING
  ACCESSIBILITY
  TRANSPORT
  OTHER
}

enum GuestRequestStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MessageSenderKind {
  GUEST
  HOTEL
}

enum PaymentMode {
  PAY_NOW
  PAY_AT_HOTEL
}

enum PaymentState {
  NOT_REQUIRED
  PENDING
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentAttemptStatus {
  INITIATED
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum RoomStatus {
  READY
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

enum PenaltyType {
  NONE
  PERCENTAGE
  FIXED_AMOUNT
  FIRST_NIGHT
  FULL_STAY
}

enum BookingEventType {
  HOLD_CREATED
  CONFIRMED
  MODIFIED
  CANCELLED
  EXPIRED
  PAYMENT_INITIATED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  REFUND_RECORDED
  ACCOUNT_LINKED
  ARRIVAL_UPDATED
  REQUEST_CREATED
  REQUEST_STATUS_UPDATED
  FRONT_DESK_NOTE_ADDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  FAILED
  REJECTED
  COMPLETED
}

enum FinancialEventType {
  BOOKING_GROSS
  ROOM_BASE
  EMPLOYEE_SERVICE
  TAX
  PLATFORM_COMMISSION
  CANCELLATION_ADJUSTMENT
  REFUND
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  displayName              String
  platformRole             PlatformRole            @default(GUEST)
  credential               Credential?
  sessions                 Session[]
  hotelMemberships         HotelMembership[]
  bookings                 Booking[]
  submittedPropertyReviews PropertyReview[]        @relation("PropertyReviewSubmitter")
  reviewedPropertyReviews  PropertyReview[]        @relation("PropertyReviewReviewer")
  uploadedMediaObjects     MediaObject[]            @relation("MediaObjectUploader")
  reviewedHotelDocuments   HotelDocument[]          @relation("HotelDocumentReviewer")
  guestRequestsCreated     BookingGuestRequest[]    @relation("GuestRequestCreator")
  frontDeskNotesAuthored   BookingFrontDeskNote[]   @relation("FrontDeskNoteAuthor")
  guestReviewsAuthored     GuestReview[]            @relation("GuestReviewAuthor")
  guestReviewReplies       GuestReview[]            @relation("GuestReviewReplyAuthor")
  guestReviewsModerated    GuestReview[]            @relation("GuestReviewModerator")
  bookingMessagesSent      BookingMessage[]         @relation("BookingMessageSender")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

model Credential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  scope      SessionScope @default(STANDARD)
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, scope, expiresAt])
}

model Hotel {
  id                 String                @id @default(cuid())
  name               String
  slug               String                @unique
  city               String
  countryCode        String                @db.Char(2)
  address            String
  area               String?
  description        String?               @db.Text
  starRating         Int?
  latitude           Decimal?              @db.Decimal(9, 6)
  longitude          Decimal?              @db.Decimal(9, 6)
  checkInTime        String?
  checkOutTime       String?
  timezone           String
  currency           String                @default("JOD") @db.Char(3)
  status             PropertyStatus        @default(DRAFT)
  verified           Boolean               @default(false)
  publishRevision    Int                   @default(1)
  publishedRevision  Int?
  lastPublishedAt    DateTime?
  commissionRate     Decimal               @default(0.10) @db.Decimal(6, 5)
  serviceRate        Decimal               @default(0.07) @db.Decimal(6, 5)
  taxRate            Decimal               @default(0.086) @db.Decimal(6, 5)
  overbookingEnabled Boolean               @default(false)
  memberships        HotelMembership[]
  roomTypes          RoomType[]
  photos             HotelPhoto[]
  amenities          HotelAmenity[]
  reviews            PropertyReview[]
  guestReviews       GuestReview[]
  promotions         Promotion[]
  conversations      BookingConversation[]
  mediaObjects       MediaObject[]
  documents          HotelDocument[]
  bookings           Booking[]
  financialEvents    FinancialEvent[]
  auditLogs          AuditLog[]
  destinationLinks   HotelDestination[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, verified, city])
  @@index([countryCode, city])
}

model MediaObject {
  id                String             @id @default(cuid())
  hotelId           String
  hotel             Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  uploadedByUserId  String
  uploadedBy        User               @relation("MediaObjectUploader", fields: [uploadedByUserId], references: [id])
  kind              MediaKind
  state             MediaState         @default(PENDING_UPLOAD)
  visibility        MediaVisibility
  objectKey         String             @unique
  originalFileName  String
  contentType       String
  expectedSizeBytes Int
  documentType      HotelDocumentType?
  publicUrl         String?
  uploadExpiresAt   DateTime
  uploadedAt        DateTime?
  deletedAt         DateTime?
  photo             HotelPhoto?
  document          HotelDocument?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([hotelId, kind, state, createdAt])
  @@index([uploadExpiresAt, state])
}

model HotelPhoto {
  id            String      @id @default(cuid())
  hotelId       String
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomTypeId    String?
  roomType      RoomType?   @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  mediaObjectId String      @unique
  mediaObject   MediaObject @relation(fields: [mediaObjectId], references: [id], onDelete: Restrict)
  alt           String?
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([hotelId, sortOrder])
  @@index([roomTypeId, sortOrder])
}

model HotelDocument {
  id               String               @id @default(cuid())
  hotelId          String
  hotel            Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  mediaObjectId    String               @unique
  mediaObject      MediaObject          @relation(fields: [mediaObjectId], references: [id], onDelete: Restrict)
  type             HotelDocumentType
  status           DocumentReviewStatus @default(PENDING)
  reviewedByUserId String?
  reviewedBy       User?                @relation("HotelDocumentReviewer", fields: [reviewedByUserId], references: [id])
  rejectionReason  String?              @db.Text
  submittedAt      DateTime             @default(now())
  reviewedAt       DateTime?

  @@index([hotelId, type, status, submittedAt])
  @@index([status, submittedAt])
}

model HotelAmenity {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  code      String
  name      String
  category  String?
  createdAt DateTime @default(now())

  @@unique([hotelId, code])
  @@index([code])
}

model PropertyReview {
  id                  String               @id @default(cuid())
  hotelId             String
  hotel               Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  submittedByUserId   String
  submittedBy         User                 @relation("PropertyReviewSubmitter", fields: [submittedByUserId], references: [id])
  reviewedByUserId    String?
  reviewedBy          User?                @relation("PropertyReviewReviewer", fields: [reviewedByUserId], references: [id])
  submittedRevision   Int
  status              PropertyReviewStatus @default(PENDING)
  readinessSnapshot   Json
  decisionReason      String?              @db.Text
  submittedAt         DateTime             @default(now())
  reviewedAt          DateTime?

  @@index([hotelId, submittedAt])
  @@index([status, submittedAt])
  @@index([reviewedByUserId, reviewedAt])
}

model HotelMembership {
  id        String           @id @default(cuid())
  hotelId   String
  hotel     Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      HotelRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([hotelId, userId])
  @@index([userId, status])
}

model RoomType {
  id                    String             @id @default(cuid())
  hotelId               String
  hotel                 Hotel              @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  description           String?            @db.Text
  unitType              RoomUnitType       @default(ROOM)
  quantity              Int                @default(1)
  maxGuests             Int                @default(2)
  maxAdults             Int
  maxChildren           Int                @default(0)
  maxInfants            Int                @default(0)
  bedroomCount          Int                @default(1)
  livingRoomCount       Int                @default(0)
  bathroomCount         Int                @default(1)
  privateBathroom       Boolean            @default(true)
  sizeValue             Decimal?           @db.Decimal(8, 2)
  sizeUnit              RoomSizeUnit       @default(SQM)
  smokingPolicy         RoomSmokingPolicy  @default(NON_SMOKING)
  extraBedCount         Int                @default(0)
  cribCount             Int                @default(0)
  allowsCribAndExtraBed Boolean            @default(false)
  active                Boolean            @default(true)
  beds                  RoomBed[]
  amenities             RoomAmenity[]
  photos                HotelPhoto[]
  physicalRooms         PhysicalRoom[]
  ratePlans             RatePlan[]
  inventory             InventoryDay[]
  bookings              Booking[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([hotelId, code])
  @@index([hotelId, active])
}

model RoomBed {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  area       String
  type       BedType
  quantity   Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([roomTypeId, sortOrder])
}

model RoomAmenity {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  code       String
  name       String
  category   String?
  createdAt  DateTime @default(now())

  @@unique([roomTypeId, code])
  @@index([code])
}

model PhysicalRoom {
  id         String     @id @default(cuid())
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomNumber String
  status     RoomStatus @default(READY)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([roomTypeId, roomNumber])
}

model RatePlan {
  id                 String              @id @default(cuid())
  roomTypeId         String
  roomType           RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name               String
  code               String
  refundable         Boolean
  mealPlan           MealPlan            @default(ROOM_ONLY)
  allowPayNow        Boolean             @default(true)
  allowPayAtHotel    Boolean             @default(true)
  active             Boolean             @default(true)
  rates              DailyRate[]
  bookings           Booking[]
  promotions         PromotionRatePlan[]
  cancellationPolicy CancellationPolicy?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([roomTypeId, code])
  @@index([roomTypeId, active])
}

model Promotion {
  id               String            @id @default(cuid())
  hotelId          String
  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name             String
  code             String
  discountPercent  Decimal           @db.Decimal(5, 2)
  bookingStartsAt  DateTime
  bookingEndsAt    DateTime
  stayStartsOn     DateTime          @db.Date
  stayEndsOn       DateTime          @db.Date
  minimumNights    Int               @default(1)
  status           PromotionStatus   @default(DRAFT)
  ratePlans        PromotionRatePlan[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([hotelId, code])
  @@index([hotelId, status, bookingStartsAt, bookingEndsAt])
  @@index([hotelId, stayStartsOn, stayEndsOn])
}

model PromotionRatePlan {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  ratePlanId  String
  ratePlan    RatePlan  @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@id([promotionId, ratePlanId])
  @@index([ratePlanId])
}

model CancellationPolicy {
  id                 String             @id @default(cuid())
  ratePlanId         String             @unique
  ratePlan           RatePlan           @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  name               String
  noShowPenaltyType  PenaltyType        @default(FULL_STAY)
  noShowPenaltyValue Decimal?           @db.Decimal(12, 5)
  rules              CancellationRule[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model CancellationRule {
  id                       String              @id @default(cuid())
  policyId                 String
  policy                   CancellationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  minimumDaysBeforeArrival Int
  penaltyType              PenaltyType
  penaltyValue             Decimal?            @db.Decimal(12, 5)
  createdAt                DateTime             @default(now())

  @@unique([policyId, minimumDaysBeforeArrival])
  @@index([policyId, minimumDaysBeforeArrival])
}

model DailyRate {
  id                     String   @id @default(cuid())
  ratePlanId             String
  ratePlan               RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  date                   DateTime @db.Date
  baseRate               Decimal  @db.Decimal(12, 2)
  minStay                Int      @default(1)
  maxStay                Int?
  minAdvanceBookingDays  Int      @default(0)
  maxAdvanceBookingDays  Int?
  closedToArrival        Boolean  @default(false)
  closedToDeparture      Boolean  @default(false)
  closed                 Boolean  @default(false)
  stopSell               Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([ratePlanId, date])
  @@index([date, closed, stopSell])
  @@index([date, closedToArrival, closedToDeparture])
}

model InventoryDay {
  id               String   @id @default(cuid())
  roomTypeId       String
  roomType         RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  available        Int
  overbookingLimit Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([date, available])
}

model Booking {
  id                               String                  @id @default(cuid())
  reference                        String                  @unique
  userId                           String?
  user                             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  hotelId                          String
  hotel                            Hotel                   @relation(fields: [hotelId], references: [id])
  roomTypeId                       String
  roomType                         RoomType                @relation(fields: [roomTypeId], references: [id])
  ratePlanId                       String
  ratePlan                         RatePlan                @relation(fields: [ratePlanId], references: [id])
  guestName                        String
  guestEmail                       String
  adults                           Int                     @default(1)
  children                         Int                     @default(0)
  arrival                          DateTime                @db.Date
  departure                        DateTime                @db.Date
  expectedArrivalTime              String?
  arrivalStatus                    ArrivalStatus           @default(NOT_PROVIDED)
  status                           BookingStatus           @default(HOLD)
  revision                         Int                     @default(1)
  paymentMode                      PaymentMode
  paymentState                     PaymentState
  currency                         String                  @db.Char(3)
  baseAmount                       Decimal                 @db.Decimal(12, 2)
  serviceAmount                    Decimal                 @db.Decimal(12, 2)
  taxAmount                        Decimal                 @db.Decimal(12, 2)
  totalAmount                      Decimal                 @db.Decimal(12, 2)
  commissionRateSnapshot           Decimal                 @db.Decimal(6, 5)
  commissionAmount                 Decimal                 @db.Decimal(12, 2)
  promotionNameSnapshot            String?
  promotionDiscountPercentSnapshot Decimal?                @db.Decimal(5, 2)
  cancellationPolicySnapshot       Json
  cancellationPenaltyAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  refundableAmount                 Decimal?                @db.Decimal(12, 2)
  idempotencyKey                   String                  @unique
  requestFingerprint               String
  accessTokenHash                  String                  @unique
  holdExpiresAt                    DateTime?
  confirmedAt                      DateTime?
  cancelledAt                      DateTime?
  nights                           BookingNight[]
  events                           BookingEvent[]
  guestRequests                    BookingGuestRequest[]
  frontDeskNotes                   BookingFrontDeskNote[]
  review                           GuestReview?
  conversation                     BookingConversation?
  refunds                          Refund[]
  paymentAttempts                  PaymentAttempt[]
  financialEvents                  FinancialEvent[]
  createdAt                        DateTime                @default(now())
  updatedAt                        DateTime                @updatedAt

  @@index([hotelId, arrival, departure, status])
  @@index([hotelId, arrival, arrivalStatus, status])
  @@index([guestEmail, createdAt])
  @@index([status, holdExpiresAt])
}

model BookingNight {
  id            String   @id @default(cuid())
  bookingId     String
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  revision      Int
  date          DateTime @db.Date
  baseAmount    Decimal  @db.Decimal(12, 2)
  serviceAmount Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@unique([bookingId, revision, date])
  @@index([bookingId, revision])
  @@index([date])
}

model BookingEvent {
  id                 String           @id @default(cuid())
  bookingId          String
  booking            Booking          @relation(fields: [bookingId], references: [id])
  type               BookingEventType
  actorUserId        String?
  idempotencyKey     String?          @unique
  requestFingerprint String?
  data               Json?
  createdAt          DateTime         @default(now())

  @@index([bookingId, createdAt])
}

model BookingGuestRequest {
  id              String               @id @default(cuid())
  bookingId       String
  booking         Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  category        GuestRequestCategory
  message         String               @db.Text
  status          GuestRequestStatus   @default(OPEN)
  createdByUserId String?
  createdBy       User?                @relation("GuestRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([bookingId, status, createdAt])
}

model BookingFrontDeskNote {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorUserId String
  author       User     @relation("FrontDeskNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([bookingId, createdAt])
  @@index([authorUserId, createdAt])
}

model GuestReview {
  id                String       @id @default(cuid())
  bookingId         String       @unique
  booking           Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelId           String
  hotel             Hotel        @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  authorUserId      String?
  author            User?        @relation("GuestReviewAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  overall           Int
  cleanliness       Int
  staff             Int
  location          Int
  facilities        Int
  comfort           Int
  value             Int
  title             String?
  comment           String       @db.Text
  status            ReviewStatus @default(PUBLISHED)
  moderationReason  String?      @db.Text
  moderatedByUserId String?
  moderatedBy       User?        @relation("GuestReviewModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  moderatedAt       DateTime?
  hotelReply        String?      @db.Text
  repliedByUserId   String?
  repliedBy         User?        @relation("GuestReviewReplyAuthor", fields: [repliedByUserId], references: [id], onDelete: SetNull)
  repliedAt         DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([hotelId, status, createdAt])
  @@index([authorUserId, createdAt])
  @@index([moderatedByUserId, moderatedAt])
}

model BookingConversation {
  id        String           @id @default(cuid())
  bookingId String           @unique
  booking   Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  messages  BookingMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([hotelId, updatedAt])
}

model BookingMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   BookingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String?
  sender         User?              @relation("BookingMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderKind     MessageSenderKind
  body           String             @db.Text
  guestReadAt    DateTime?
  hotelReadAt    DateTime?
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model PaymentAttempt {
  id                 String               @id @default(cuid())
  bookingId          String
  booking            Booking              @relation(fields: [bookingId], references: [id])
  provider           String
  status             PaymentAttemptStatus @default(INITIATED)
  amount             Decimal              @db.Decimal(12, 2)
  currency           String               @db.Char(3)
  idempotencyKey     String               @unique
  requestFingerprint String
  externalPaymentId  String?
  returnUrl          String
  redirectUrl        String?
  failureCode        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  completedAt        DateTime?

  @@unique([provider, externalPaymentId])
  @@index([bookingId, createdAt])
  @@index([provider, status, createdAt])
}

model Refund {
  id                String       @id @default(cuid())
  bookingId         String
  booking           Booking      @relation(fields: [bookingId], references: [id])
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @db.Char(3)
  reason            String
  status            RefundStatus @default(REQUESTED)
  requestedByUserId String?
  provider          String?
  externalReference String?
  failureCode       String?
  createdAt         DateTime     @default(now())
  completedAt       DateTime?

  @@index([bookingId, createdAt])
  @@index([provider, status, createdAt])
}

model FinancialEvent {
  id            String             @id @default(cuid())
  bookingId     String
  booking       Booking            @relation(fields: [bookingId], references: [id])
  hotelId       String
  hotel         Hotel              @relation(fields: [hotelId], references: [id])
  type          FinancialEventType
  amount        Decimal            @db.Decimal(12, 2)
  currency      String             @db.Char(3)
  referenceType String
  referenceId   String
  createdAt     DateTime           @default(now())

  @@index([bookingId, createdAt])
  @@index([hotelId, type, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  hotelId     String?
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([actorUserId, createdAt])
}

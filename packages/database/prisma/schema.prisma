generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  GUEST
  HOTEL_USER
  PLATFORM_ADMIN
}

enum HotelRole {
  OWNER
  MANAGER
  REVENUE
  FRONT_DESK
  FINANCE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  HOLD
  CONFIRMED
  MODIFIED
  CANCELLED
  NO_SHOW
  EXPIRED
}

enum PaymentMode {
  PAY_NOW
  PAY_AT_HOTEL
}

enum RoomStatus {
  READY
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum MealPlan {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  displayName      String
  platformRole     PlatformRole      @default(GUEST)
  credential       Credential?
  sessions         Session[]
  hotelMemberships HotelMembership[]
  bookings         Booking[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Credential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model Hotel {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  city              String
  countryCode       String             @db.Char(2)
  address           String
  timezone          String
  currency          String             @default("JOD") @db.Char(3)
  status            PropertyStatus     @default(DRAFT)
  verified          Boolean            @default(false)
  commissionRate    Decimal            @default(0.10) @db.Decimal(6,5)
  serviceRate       Decimal            @default(0.07) @db.Decimal(6,5)
  taxRate           Decimal            @default(0.086) @db.Decimal(6,5)
  overbookingEnabled Boolean           @default(false)
  memberships       HotelMembership[]
  roomTypes         RoomType[]
  bookings          Booking[]
  auditLogs         AuditLog[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model HotelMembership {
  id        String           @id @default(cuid())
  hotelId   String
  hotel     Hotel            @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      HotelRole
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([hotelId, userId])
  @@index([userId, status])
}

model RoomType {
  id            String          @id @default(cuid())
  hotelId       String
  hotel         Hotel           @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name          String
  code          String
  maxAdults     Int
  maxChildren   Int             @default(0)
  active        Boolean         @default(true)
  physicalRooms PhysicalRoom[]
  ratePlans     RatePlan[]
  inventory     InventoryDay[]
  bookings      Booking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([hotelId, code])
  @@index([hotelId, active])
}

model PhysicalRoom {
  id         String     @id @default(cuid())
  roomTypeId String
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomNumber String
  status     RoomStatus @default(READY)
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([roomTypeId, roomNumber])
}

model RatePlan {
  id          String      @id @default(cuid())
  roomTypeId  String
  roomType    RoomType    @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name        String
  code        String
  refundable  Boolean
  mealPlan    MealPlan    @default(ROOM_ONLY)
  active      Boolean     @default(true)
  rates       DailyRate[]
  bookings    Booking[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([roomTypeId, code])
  @@index([roomTypeId, active])
}

model DailyRate {
  id         String   @id @default(cuid())
  ratePlanId String
  ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  baseRate   Decimal  @db.Decimal(12,2)
  minStay    Int      @default(1)
  maxStay    Int?
  closed     Boolean  @default(false)
  stopSell   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([ratePlanId, date])
  @@index([date, closed, stopSell])
}

model InventoryDay {
  id               String   @id @default(cuid())
  roomTypeId       String
  roomType         RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  available        Int
  overbookingLimit Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([roomTypeId, date])
  @@index([date, available])
}

model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  hotelId        String
  hotel          Hotel         @relation(fields: [hotelId], references: [id])
  roomTypeId     String
  roomType       RoomType      @relation(fields: [roomTypeId], references: [id])
  ratePlanId     String
  ratePlan       RatePlan      @relation(fields: [ratePlanId], references: [id])
  guestName      String
  guestEmail     String
  arrival        DateTime      @db.Date
  departure      DateTime      @db.Date
  status         BookingStatus @default(HOLD)
  paymentMode    PaymentMode
  currency       String        @db.Char(3)
  baseAmount     Decimal       @db.Decimal(12,2)
  serviceAmount  Decimal       @db.Decimal(12,2)
  taxAmount      Decimal       @db.Decimal(12,2)
  totalAmount    Decimal       @db.Decimal(12,2)
  idempotencyKey String        @unique
  holdExpiresAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([hotelId, arrival, departure, status])
  @@index([guestEmail, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  hotelId     String?
  hotel       Hotel?   @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([actorUserId, createdAt])
}

enum CarFinanceTransactionType {
  CUSTOMER_PAYMENT
  COMPANY_COLLECTED_PAYMENT
  PLATFORM_COMMISSION
  COMPANY_PAYOUT
  COMPANY_REMITTANCE
  REFUND
  CHARGEBACK
  ADJUSTMENT
}

enum CarSettlementStatus {
  READY
  PAID
  VOID
}

enum CarSettlementDirection {
  PLATFORM_OWES_COMPANY
  COMPANY_OWES_PLATFORM
  BALANCED
}

model CarFinanceTransaction {
  id                  String                    @id @default(cuid())
  companyId           String
  reservationId       String?
  settlementId        String?
  type                CarFinanceTransactionType
  currency            String                    @db.Char(3)
  amount              Decimal                   @db.Decimal(14, 2)
  companyBalanceDelta Decimal                   @db.Decimal(14, 2)
  metadata            Json?
  createdByUserId     String?
  createdAt           DateTime                  @default(now())

  @@index([companyId, createdAt])
  @@index([reservationId, createdAt])
  @@index([settlementId, createdAt])
  @@index([type, createdAt])
}

model CarFinanceSettlement {
  id                        String                 @id @default(cuid())
  companyId                 String
  settlementNumber          String                 @unique
  periodStart               DateTime               @db.Date
  periodEnd                 DateTime               @db.Date
  currency                  String                 @db.Char(3)
  bookingCount              Int                    @default(0)
  grossBookingValue         Decimal                @default(0) @db.Decimal(14, 2)
  platformCollectedGross    Decimal                @default(0) @db.Decimal(14, 2)
  companyCollectedGross     Decimal                @default(0) @db.Decimal(14, 2)
  platformCommission        Decimal                @default(0) @db.Decimal(14, 2)
  companyCommissionReceivable Decimal              @default(0) @db.Decimal(14, 2)
  companyGrossPayable       Decimal                @default(0) @db.Decimal(14, 2)
  netAmount                 Decimal                @default(0) @db.Decimal(14, 2)
  direction                 CarSettlementDirection
  status                    CarSettlementStatus    @default(READY)
  externalReference         String?
  notes                     String?                @db.Text
  attachmentUrl             String?
  snapshot                  Json
  createdByUserId           String
  paidByUserId              String?
  paidAt                    DateTime?
  voidedAt                  DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  @@index([companyId, status, periodEnd])
  @@index([companyId, createdAt])
}

model CarFinanceSettlementItem {
  id                  String   @id @default(cuid())
  settlementId        String
  reservationId       String   @unique
  reservationReference String
  paymentMode         String
  grossAmount         Decimal  @db.Decimal(14, 2)
  commissionAmount    Decimal  @db.Decimal(14, 2)
  companyPayable      Decimal  @default(0) @db.Decimal(14, 2)
  companyReceivable   Decimal  @default(0) @db.Decimal(14, 2)
  netCompanyDelta     Decimal  @db.Decimal(14, 2)
  createdAt           DateTime @default(now())

  @@index([settlementId, createdAt])
  @@index([reservationReference])
}

model NuiteeContentHotel {
  providerHotelId  String    @id @db.VarChar(128)
  name             String
  countryCode      String?   @db.VarChar(2)
  city             String?
  area             String?
  address          String?   @db.Text
  starRating       Float?
  contentHash      String?   @db.VarChar(64)
  raw              Json
  claimedByHotelId String?   @unique
  claimedAt        DateTime?
  syncedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([countryCode, city])
  @@index([syncedAt])
  @@index([claimedByHotelId])
}

enum NuiteeClaimRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model NuiteeHotelClaimRequest {
  id                String                   @id @default(cuid())
  hotelId           String                   @unique
  providerHotelId   String                   @db.VarChar(128)
  status            NuiteeClaimRequestStatus @default(PENDING)
  submittedByUserId String
  submittedAt       DateTime                 @default(now())
  reviewedByUserId  String?
  reviewedAt        DateTime?
  rejectionReason   String?                  @db.Text
  snapshot          Json?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([providerHotelId, status])
  @@index([status, submittedAt])
}

model NuiteeContentSyncState {
  id              String   @id @db.VarChar(32)
  countryCode     String   @db.VarChar(2)
  nextOffset      Int      @default(0)
  cycle           Int      @default(0)
  lastCompletedAt DateTime?
  lastError       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([countryCode])
}

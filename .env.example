DATABASE_URL=postgresql://hotel:hotel@localhost:5432/hotel_platform?schema=public
NEXT_PUBLIC_SITE_URL=https://handmekey.com
SESSION_COOKIE_NAME=hp_session
SESSION_TTL_DAYS=30
ADMIN_SESSION_COOKIE_NAME=hp_admin_session
ADMIN_SESSION_TTL_HOURS=8
BOOKING_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Platform root authority. Set exactly one stable owner identity in production.
# The configured account must exist and have PLATFORM_ADMIN role.
# Prefer USER_ID because it survives email changes; EMAIL is supported for bootstrap.
PLATFORM_OWNER_USER_ID=
PLATFORM_OWNER_EMAIL=

# Hotel connectivity credentials are encrypted at rest before database persistence.
# Generate exactly 32 random bytes and store them as base64. Keep this stable and secret in every environment.
# PowerShell example: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
CONNECTIVITY_ENCRYPTION_KEY=

# Transactional email. `none` queues messages but never claims they were sent.
EMAIL_PROVIDER=none
EMAIL_FROM=HandMeKey <bookings@handmekey.com>
EMAIL_REPLY_TO=support@handmekey.com
RESEND_API_KEY=replace-me
EMAIL_DELIVERY_BATCH_SIZE=50
EMAIL_SYNC_INTERVAL_MS=60000
# Inbound email gateway for Admin email conversations.
# Configure your mail provider/forwarder to POST normalized inbound messages to:
# POST https://handmekey.com/api/v1/communications/email/inbound
# Header: x-handmekey-email-secret: <EMAIL_INBOUND_WEBHOOK_SECRET>
EMAIL_INBOUND_DOMAIN=reply.handmekey.com
EMAIL_INBOUND_WEBHOOK_SECRET=replace-with-at-least-32-random-characters

# Online payments. HandMeKey never simulates payment capture.
PAYMENT_PROVIDER=none
# First production adapter: PayTabs Jordan hosted payment page / 3DS flow.
PAYTABS_ENDPOINT=https://secure-jordan.paytabs.com
PAYTABS_PROFILE_ID=replace-me
PAYTABS_SERVER_KEY=replace-me
PAYTABS_CALLBACK_URL=https://handmekey.com/api/v1/payments/paytabs/callback

# Public/legal invoice identity. Complete these before issuing production customer documents.
LEGAL_ENTITY_NAME=HandMeKey
LEGAL_ENTITY_ADDRESS=Jordan
TAX_REGISTRATION_NUMBER=
SUPPORT_EMAIL=support@handmekey.com

HOLD_EXPIRY_INTERVAL_MS=30000
HOLD_EXPIRY_BATCH_SIZE=200
MEDIA_UPLOAD_CLEANUP_BATCH_SIZE=200
PRICE_WATCH_INTERVAL_MS=3600000
PRICE_WATCH_BATCH_SIZE=100

# Google Hotel Center / Free Booking Links.
# Hotel List and Landing Pages feeds are generated automatically from ACTIVE + verified hotels.
# Set ENABLED only after the HandMeKey Hotel Center account is onboarded/certified.
GOOGLE_HOTELS_ENABLED=false
GOOGLE_HOTELS_ACCOUNT_ID=
GOOGLE_HOTELS_PARTNER_ID=
# Optional HTTP Basic auth for the hosted XML feeds. Leave both blank for public feed URLs.
GOOGLE_HOTELS_FEED_USERNAME=
GOOGLE_HOTELS_FEED_PASSWORD=
# ARI credentials are supplied/configured during Google connectivity onboarding.
# HandMeKey does not claim rate/inventory delivery until all three values are real.
GOOGLE_HOTELS_ARI_ENDPOINT=
GOOGLE_HOTELS_ARI_USERNAME=
GOOGLE_HOTELS_ARI_PASSWORD=

# Secure object storage. Keep `none` until a real S3-compatible bucket is configured.
STORAGE_PROVIDER=none
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=hotel-platform-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_PATH_STYLE=true
# Required for public hotel images. Use a CDN/public image origin; verification documents must remain private.
STORAGE_PUBLIC_BASE_URL=https://media.example.com/

# Local media development:
# `docker compose up -d minio minio-init` starts a local S3-compatible MinIO service.
# Run `powershell -ExecutionPolicy Bypass -File .\scripts\configure-local-storage.ps1`
# to safely update your local .env to the matching values below without exposing verification documents.
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=hotel-platform-media
# S3_ACCESS_KEY_ID=handmekey
# S3_SECRET_ACCESS_KEY=handmekey-local-storage
# S3_PATH_STYLE=true
# STORAGE_PUBLIC_BASE_URL=http://localhost:9000/hotel-platform-media/
